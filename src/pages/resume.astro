---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { withBase } from '../utils/base';
import { projectPath } from '../utils/paths.mjs';
import { SITE } from '../site.config';

// 简历以网页文本为主（手机可读、可选中、可直接打印成 PDF）；
// 若仓库里放了对外版 PDF，则额外给一个下载/留档入口。
const hasPdf = existsSync(projectPath('public', 'resume', 'resume.pdf'));

const skillGroups = [
  {
    title: 'Agent / LLM 工程',
    items: 'Agno、LangChain、ReAct、RAG、多 Agent 协作（MAS）、Workflow 编排；熟悉 MCP、Tool Call、Skill、Model Router、Agent Memory、会话管理与异步任务',
  },
  {
    title: 'Agent 评测与可观测',
    items: '评测集建设、Judge 评分、Scorecard、版本覆盖回归；LLM Tracing、Token 用量统计、SSE 流式可观测',
  },
  {
    title: '后端与服务',
    items: 'Python、FastAPI、Django、Redis；异步接口、流式通信（SSE/WebSocket）、服务监控与性能优化',
  },
  {
    title: '数据与客户端',
    // 原 PDF 此行疑有缺项，请本人核对后补齐
    items: 'MySQL、MongoDB；React、PyQt、PyInstaller / Inno Setup 打包发布',
  },
  {
    title: '工程方法',
    items: 'SDD / TDD、Spec Change 驱动开发、Git / SVN、接口测试、自动化测试、持续交付',
  },
];

const experience = [
  {
    company: '网易（杭州）网络有限公司',
    role: '高级测试开发工程师',
    period: '2025.12 – 至今',
    location: '杭州 · 网易互娱',
    intro:
      '主项目：QA Agent 平台与 QAClient 质量工作台（主导研发）。面向游戏 QA 的环境管理、版本操作、客户端调试、GM 指令和测试执行场景，构建「PyQt 桌面端 + React Web 管理端 + FastAPI/AgentOS 服务」的分层架构：桌面端承载工具入口与本地调试，Web 端（Docker 部署、OpenID 认证、角色权限）承载 Agent 会话、任务、评测与团队协作。',
    groups: [
      {
        title: 'Agent 开发',
        bullets: [
          '基于 Agno / AgentOS 建成 19 个职责 Agent（规划、环境、执行、后处理、用例生成、用例修订等），设计 Coordinator + WorkerPool 多 Agent 团队调度模式；结合 Model Router 按 Reason / Plan / ToolCall 场景选择模型，平衡效果与成本。',
          '设计 30+ MCP / 内置工具，将客户端启停、服务端管理、SVN 分支切换、游戏状态查询、GM / REPL、Hunter2 远程设备执行封装为标准 Tool，打通 Agent、游戏进程与本地环境；实现 MCP 双向桥接与 Skill 热加载。',
          '建立 Agent 工程化底座：三层 Hook（上下文注入 / 工具越权拦截 / Prompt 治理）、Memory 蒸馏 + Milvus 向量检索、Session Summary、会话崩溃恢复、沙箱工作区与 HITL 人机协同，解决游戏环境复杂、模型直接操作不稳定的问题。',
        ],
      },
      {
        title: '评测与可观测',
        bullets: [
          '建成 Agent 评测体系：自动 Judge 评分、Scorecard、版本覆盖回归与 bug 覆盖评测（L4），沉淀评测集与回归基线，用例生成质量从「人工抽检」转为「自动全量评测」，单轮回归评测由小时级降至分钟级。',
          '落地全链路可观测：接入 Agno Tracing，自研 Tracing Dashboard 与 LLM 用量观测，Token 消耗与上下文占用全程可视，长链路任务异常从翻日志定位（30min+）降至面板分钟级定位。',
          '构建「需求 / 协作单 → 测试计划 → 环境准备 → 自动执行 → 结果汇总」质量工作流，自动化执行支持 RTMP 推流直播与录像回放，执行过程实时可看。',
        ],
      },
      {
        title: '其它项目',
        bullets: [
          '持续迭代 QAOutlook 质量管理平台，完成版本管理、QA 复盘、绩效统计、测试资产和质量数据分析等模块建设，提高统计与数据一致性，提升质量信息的可追溯性。',
          '参与游戏测试自动化及配套能力建设，沉淀 100+ 场景 / 原子能力、170+ 用例，覆盖冒烟、功能回归、UI 链路探针等场景；配合 QAClient 与 Agent 工具链完成执行能力集成。',
          '建设质量事件与流程联动能力，打通 Redmine 工单、版本发布、测试执行和质量日报等系统，支撑 40+ 自动化场景，减少跨系统重复操作。',
          '以 Spec Change 驱动研发，累计沉淀 150+ Spec Change（覆盖 Agent 服务、QAClient、质量平台、测试工具与事件系统），形成「需求 → 实现 → 验证 → 复盘」闭环，Agent Skill、MCP Tool、接口规范等资产持续复用。',
        ],
      },
    ],
    highlight: '业务自动化覆盖率超 80%，数字员工日均处理 50+ 操作请求，日均节省约 2 pd；平台由个人工具演进为团队级质量基建。',
  },
  {
    company: '联想（北京）有限公司',
    role: 'CSP Product Assurance Engineer',
    period: '2023.08 – 2025.12',
    location: '北京',
    groups: [
      {
        title: '',
        bullets: [
          '负责 TestAnyWhere 测试平台研发，搭建分布式并发测试架构，基于 Redis、Celery 实现测试任务编排、状态追踪和全生命周期监控；优化 MySQL 检索性能并开发 SMB 文件通信能力，每月节省约 80 人日。',
          '独立研发 AI Log Review 智能日志分析系统，采用 ReAct 与父子图工作流处理长文本日志，通过 FastAPI 支持异步并发，结合 PostgreSQL 实现分析记忆持久化，提升测试复盘效率和结论一致性。',
          '推动 AI 能力融入质量工程流程，围绕日志归因、测试复盘和问题定位设计可扩展的 Agent 化方案。',
        ],
      },
    ],
  },
];

const education = [
  {
    school: '北京工业大学',
    major: '软件工程',
    degree: '硕士（全日制）',
    period: '2020.09 – 2023.07',
    notes: ['AI 领域发明专利 2 项；SCI Q2 期刊论文 1 篇；C 类会议论文 3 篇。'],
  },
  {
    school: '重庆交通大学',
    major: '通信工程',
    degree: '本科（全日制）',
    period: '2016.09 – 2020.06',
    notes: ['ACM 重庆赛区二等奖；蓝桥杯省赛二等奖。'],
  },
];

const targets = ['Agent 开发工程师', 'Agent 评测 / 可观测工程师', 'AI 应用工程师', '测试开发 / 质量效能平台负责人'];
---

<BaseLayout title="简历" description={`${SITE.author} 的简历：Agent 工程、评测与可观测方向`}>
  <div class="head shell">
    <h1>简历</h1>
    <p class="head__meta">
      {SITE.author} · 男 · 1997.10 · 杭州 · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
    {
      hasPdf && (
        <p class="head__actions">
          <a href={withBase('/resume/resume.pdf')} download>
            下载 PDF 版
          </a>
          <span class="head__hint">本页也可直接用浏览器打印成 PDF</span>
        </p>
      )
    }
  </div>

  <Prose wide>
    <h2>核心技能</h2>
    <dl class="skills">
      {
        skillGroups.map((group) => (
          <div class="skills__row">
            <dt>{group.title}</dt>
            <dd>{group.items}</dd>
          </div>
        ))
      }
    </dl>

    <h2>工作经历</h2>
    {
      experience.map((job) => (
        <section class="job">
          <h3>
            {job.company} <span class="job__role">｜{job.role}</span>
          </h3>
          <p class="job__meta">
            {job.period}
            {job.location ? `｜${job.location}` : ''}
          </p>
          {job.intro && <p>{job.intro}</p>}
          {job.groups.map((group) => (
            <>
              {group.title && <h4>{group.title}</h4>}
              <ul>
                {group.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </>
          ))}
          {job.highlight && <p class="job__highlight">{job.highlight}</p>}
        </section>
      ))
    }

    <h2>教育经历</h2>
    {
      education.map((item) => (
        <section class="edu">
          <h3>
            {item.school} <span class="job__role">｜{item.major}｜{item.degree}</span>
          </h3>
          <p class="job__meta">{item.period}</p>
          <ul>
            {item.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2>求职方向</h2>
    <ul>
      {targets.map((target) => (
        <li>{target}</li>
      ))}
    </ul>
  </Prose>
</BaseLayout>

<style>
  .head {
    max-width: var(--measure-wide);
    margin-inline: auto;
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .head__meta {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .head__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
    font-size: var(--text-xs);
  }

  .head__actions a {
    display: inline-block;
    padding: 0.25em 0.7em;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .head__actions a:hover {
    background: var(--color-accent-soft);
  }

  .head__hint {
    color: var(--color-text-faint);
  }

  .skills__row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .skills__row dt {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .skills__row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .job,
  .edu {
    margin-top: var(--space-5);
  }

  .job h3,
  .edu h3 {
    margin: 0;
    font-size: var(--text-base);
    border-bottom: none;
    padding-bottom: 0;
  }

  .job__role {
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .job__meta {
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .job__highlight {
    margin-top: var(--space-3);
    padding: var(--space-3);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--color-accent-soft);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  @media (max-width: 40rem) {
    .skills__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
